# App (use HTTPS public URLs in production)
NEXT_PUBLIC_APP_URL=
NEXTAUTH_URL=
NEXTAUTH_SECRET=
ADMIN_EMAIL=

# Database
MONGODB_URI=
MONGODB_DB=AVGCONNECTS

# Optional OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mercado Pago
MERCADOPAGO_MODE=sandbox
MERCADOPAGO_ACCESS_TOKEN=
# Checkout Pro by redirect does not consume this key, but it is required if a client SDK is enabled later.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CURRENCY=ARS

# Local development only. Never set to true in production.
MERCADOPAGO_ALLOW_UNSIGNED_WEBHOOKS=false
