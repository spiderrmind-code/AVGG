# APP
# Production: https://your-domain.example (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Legacy fallback; prefer NEXT_PUBLIC_SITE_URL for new deployments.
NEXT_PUBLIC_APP_URL=

# DATABASE
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE?retryWrites=true&w=majority
MONGODB_DB=AVGCONNECTS

# AUTH
NEXTAUTH_URL=https://your-domain.example
NEXTAUTH_SECRET=replace-with-a-long-random-server-secret
ADMIN_EMAIL=admin@your-domain.example

# GOOGLE
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# MERCADO PAGO
MERCADOPAGO_MODE=sandbox
MERCADOPAGO_ACCESS_TOKEN=replace-with-server-access-token
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=replace-with-public-key-if-client-sdk-is-enabled
MERCADOPAGO_WEBHOOK_SECRET=replace-with-webhook-signing-secret
MERCADOPAGO_CURRENCY=ARS
MERCADOPAGO_ALLOW_UNSIGNED_WEBHOOKS=false

# CJ DROPSHIPPING
CJ_API_KEY=replace-with-cj-api-key
CJ_AUTO_FULFILLMENT_ENABLED=false
CJ_ORDER_CREATION_ENABLED=false
CJ_LIVE_READ_ENABLED=false
CJ_REQUEST_TIMEOUT_MS=12000
CJ_MAX_RETRIES=2
CJ_COST_CURRENCY=USD
CJ_MIN_MARGIN_PERCENT=0
CJ_MAX_COST_INCREASE_PERCENT=0
CJ_FX_RATE_USD_ARS=
CJ_FX_RATE_UPDATED_AT=
CJ_TEST_PRODUCT_ID=
CJ_TEST_VARIANT_ID=
CJ_TEST_COUNTRY_CODE=AR
CJ_TEST_POSTAL_CODE=
# Legacy script only; do not use for the canonical server integration.
CJ_ACCESS_TOKEN=

# OBSERVABILITY
ALERTS_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_EMAIL=
MONGO_SLOW_QUERY_MS=500
# Optional observability providers; do not commit values.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# SECURITY
NODE_ENV=development
