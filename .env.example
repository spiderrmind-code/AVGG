# 13 Studio Tattoo: public origin (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-studio-domain.example
NEXTAUTH_URL=https://your-studio-domain.example

# Keep both deployment flags true only in the independently configured Studio project.
STUDIO_DEPLOYMENT=false
NEXT_PUBLIC_STUDIO_DEPLOYMENT=false

# Dedicated Studio persistence. Never use an AVG database or URI.
STUDIO_MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE?retryWrites=true&w=majority
STUDIO_MONGODB_DB=13_studio_tattoo

# Optional zero-cost alternative: an HTTPS Worker bound privately to Studio D1.
# Set both only after deploying workers/studio-booking to the Studio Cloudflare account.
STUDIO_D1_WORKER_URL=
STUDIO_D1_WORKER_SHARED_SECRET=

# Dedicated Studio authentication and authorization.
STUDIO_NEXTAUTH_SECRET=replace-with-a-long-random-server-secret
STUDIO_ADMIN_EMAIL=admin@your-studio-domain.example
STUDIO_GOOGLE_CLIENT_ID=replace-with-studio-google-oauth-client-id
STUDIO_GOOGLE_CLIENT_SECRET=replace-with-studio-google-oauth-client-secret

# Public contact number: digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=542212203747

# Keep every data-collection flag false until the data controller, notice, and retention policy are approved.
STUDIO_PRIVACY_APPROVED=false
NEXT_PUBLIC_STUDIO_PRIVACY_APPROVED=false
STUDIO_RETENTION_POLICY_APPROVED=false
NEXT_PUBLIC_STUDIO_RETENTION_POLICY_APPROVED=false
STUDIO_DATA_COLLECTION_ENABLED=false
NEXT_PUBLIC_STUDIO_DATA_COLLECTION_ENABLED=false

# Appointment requests can remain disabled while approved customer accounts are enabled.
STUDIO_APPOINTMENT_REQUESTS_ENABLED=false
NEXT_PUBLIC_STUDIO_APPOINTMENT_REQUESTS_ENABLED=false

# Optional distributed rate limiting for Studio only. Leave both empty to use the local fallback in development.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
