# APP
# Production: https://your-domain.example (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Legacy fallback; prefer NEXT_PUBLIC_SITE_URL for new deployments.
NEXT_PUBLIC_APP_URL=

# DATABASE
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE?retryWrites=true&w=majority
MONGODB_DB=AVGCONNECTS

# AUTH
NEXTAUTH_URL=https://your-domain.example
NEXTAUTH_SECRET=replace-with-a-long-random-server-secret
ADMIN_EMAIL=admin@your-domain.example

# GOOGLE
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# MERCADO PAGO
MERCADOPAGO_MODE=sandbox
MERCADOPAGO_ACCESS_TOKEN=replace-with-server-access-token
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=replace-with-public-key-if-client-sdk-is-enabled
MERCADOPAGO_WEBHOOK_SECRET=replace-with-webhook-signing-secret
MERCADOPAGO_CURRENCY=ARS
MERCADOPAGO_ALLOW_UNSIGNED_WEBHOOKS=false

# CATALOG PROVIDER
DROPSHEABLE_API_KEY=replace-with-dropsheable-api-key
# Percentage charged to the seller by Dropsheable; keep configurable per account/plan.
DROPSHEABLE_FEE_RATE=3

# AVG AI (server-side only; create a key in Google AI Studio)
GEMINI_API_KEY=
# Optional: defaults to gemini-2.5-flash.
GEMINI_MODEL=

# SUPPLIERS
# Base64 encoding of exactly 32 random bytes. Server-side only; rotate using the provider runbook.
SUPPLIER_CREDENTIALS_ENCRYPTION_KEY=

# OBSERVABILITY
ALERTS_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_EMAIL=
MONGO_SLOW_QUERY_MS=500
# Optional observability providers; do not commit values.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# SECURITY
NODE_ENV=development
# Vercel Cron secret used by /api/cron/dropsheable-sync. Keep server-side only.
VERCEL_CRON_SECRET=replace-with-a-long-random-server-secret
CRON_SECRET=
# Optional distributed Redis REST backend for serverless rate limiting. Without these, development uses an in-memory fallback.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
